# ── Paste your key here, then save this file as ".env" (start scripts do the copy for you) ──
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=

PORT=4000

# Hindsight (started automatically by docker-compose using your Groq key)
HINDSIGHT_BASE_URL=http://localhost:8888
# Only needed for Hindsight Cloud (https://ui.hindsight.vectorize.io/connect). Leave blank for local Docker.
HINDSIGHT_API_KEY=
